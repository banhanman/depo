HOST=0.0.0.0
PORT=4620
HTTPS_PORT=4621
DEPO_DATA_DIR=./data
DEPO_BACKUP_DIR=./backups
DEPO_BACKUP_KEEP=14
DEPO_VOICE_URL=http://127.0.0.1:2701

# Обновление CLI агентов (Claude Code, Codex, Kimi, Gemini): 1 — ставить новые версии само, 0 — только по кнопке
# DEPO_CLI_AUTOUPDATE=0
# Не опрашивать лимиты Codex через `codex app-server`
# DEPO_NO_CODEX_LIMITS=1
# Сколько держать открытым живой процесс Claude для подсказок «на ходу», мс
# DEPO_STEER_IDLE_MS=60000
# Kimi Code: свой каталог профиля, адрес API и прокси для запросов лимитов
# KIMI_CODE_HOME=~/.kimi-code
# KIMI_CODE_BASE_URL=https://api.kimi.com/coding/v1
# DEPO_KIMI_PROXY=http://127.0.0.1:8080
# Telegram /pi: какие службы systemd и какие диски показывать (через пробел)
# DEPO_TG_SERVICES="depo depo-voice netbird"
# DEPO_TG_DISKS="/mnt/data"
