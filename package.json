{
  "name": "depo",
  "version": "0.2.0",
  "description": "Self-hosted web hub for Claude Code, Codex, Gemini and Kimi on your own server",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/banhanman/depo.git"
  },
  "homepage": "https://github.com/banhanman/depo#readme",
  "keywords": [
    "self-hosted",
    "claude-code",
    "codex",
    "gemini-cli",
    "kimi-code",
    "raspberry-pi",
    "ai-agents",
    "developer-tools",
    "web-ui",
    "nodejs"
  ],
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server.mjs",
    "setup": "node scripts/setup.mjs",
    "backup": "node scripts/backup.mjs",
    "test": "node --test tests/*.test.mjs",
    "check:ui": "node scripts/ui-check.mjs"
  }
}
